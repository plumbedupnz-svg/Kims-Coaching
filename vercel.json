{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/racket-reminders", "schedule": "0 21 * * *" },
    { "path": "/api/xero-webhook", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/racket-reminders.js": { "maxDuration": 60 },
    "api/xero.js": { "maxDuration": 60 },
    "api/xero-webhook.js": { "maxDuration": 60 },
    "api/shop-checkout.js": { "maxDuration": 60 }
  },
  "redirects": [{ "source": "/book-private-lesson", "destination": "/booking", "permanent": true }],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/booking-confirmation", "destination": "/booking-confirmation.html" },
    { "source": "/payment-success", "destination": "/payment-success.html" },
    { "source": "/payment-cancelled", "destination": "/payment-cancelled.html" },
    { "source": "/email-verified", "destination": "/email-verified.html" },
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/login", "destination": "/account.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/order-payment", "destination": "/order-payment.html" }
  ]
}
